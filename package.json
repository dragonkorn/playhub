{
  "name": "playhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @playhub/web dev",
    "dev:server": "pnpm --filter @playhub/server dev",
    "build": "pnpm --filter @playhub/web build",
    "deploy": "pnpm build && pnpm --filter @playhub/server deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node scripts/e2e-room.mjs && node scripts/e2e-ui.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
